datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AppointmentStatus {
  BOOKED
  IN_CHAIR
  COMPLETED
  NO_SHOW
  CANCELLED
  BLOCKED
}

model Shop {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  phoneNumber   String   @map("phone_number")
  address       String?
  whatsappApiId String?  @map("whatsapp_api_id")
  createdAt     DateTime @default(now()) @map("created_at")

  settings     ShopSettings?
  staff        Staff[]
  services     Service[]
  appointments Appointment[]

  @@map("shops")
}

model ShopSettings {
  id             String  @id @default(uuid())
  shopId         String  @unique @map("shop_id")
  shop           Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  minNoticeHours Int     @default(1) @map("min_notice_hours")
  maxAdvanceDays Int     @default(14) @map("max_advance_days")
  bufferMins     Int     @default(10) @map("buffer_mins")
  isBookingOpen  Boolean @default(true) @map("is_booking_open")
  operatingHours Json    @map("operating_hours")

  @@map("shop_settings")
}

model Staff {
  id       String  @id @default(uuid())
  shopId   String  @map("shop_id")
  shop     Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name     String
  isActive Boolean @default(true) @map("is_active")

  services       StaffService[]
  appointments   Appointment[]
  dailySchedules DailyStaffSchedule[]

  @@map("staff")
}

model Service {
  id           String  @id @default(uuid())
  shopId       String  @map("shop_id")
  shop         Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name         String
  durationMins Int     @map("duration_mins")
  price        Decimal @db.Decimal(10, 2)

  staffMembers        StaffService[]
  appointmentServices AppointmentService[]

  @@map("services")
}

// Join table for Staff and Service (Many-to-Many)
model StaffService {
  staffId   String  @map("staff_id")
  serviceId String  @map("service_id")
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

model Customer {
  id            String   @id @default(uuid())
  phoneNumber   String   @unique @map("phone_number")
  name          String
  noShowStrikes Int      @default(0) @map("no_show_strikes")
  createdAt     DateTime @default(now()) @map("created_at")

  appointments Appointment[]

  @@map("customers")
}

model Appointment {
  id          String            @id @default(uuid())
  shopId      String            @map("shop_id")
  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staffId     String            @map("staff_id")
  staff       Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customerId  String?           @map("customer_id")
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  clientName  String?           @map("client_name")
  startTime   DateTime          @map("start_time")
  endTime     DateTime          @map("end_time")
  actualStartTime DateTime?     @map("actual_start_time")
  actualEndTime DateTime?       @map("actual_end_time")
  status      AppointmentStatus @default(BOOKED)
  manageToken String?           @unique @default(uuid()) @map("manage_token")
  createdAt   DateTime          @default(now()) @map("created_at")

  services AppointmentService[]

  @@index([shopId, startTime])
  @@index([staffId, startTime])
  @@map("appointments")
}

// Join table for multiple services in one booking
model AppointmentService {
  appointmentId String      @map("appointment_id")
  serviceId     String      @map("service_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([appointmentId, serviceId])
  @@map("appointment_services")
}

model DailyStaffSchedule {
  id        String   @id @default(uuid())
  staffId   String   @map("staff_id")
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  isWorking Boolean  @default(true) @map("is_working")

  @@unique([staffId, date])
  @@map("daily_staff_schedules")
}